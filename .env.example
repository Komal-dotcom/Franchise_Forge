# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Amazon S3 Configuration (Optional - Local mock fallback available)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=franchise-forge-submissions

# Modular AI Judge Service Configuration
# Choices: "ollama" | "mock"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava

# Admin & Session Authentication Secrets
ADMIN_SECRET_PIN=studio2026admin
JWT_SECRET=franchise-forge-super-secret-jwt-key-2026
